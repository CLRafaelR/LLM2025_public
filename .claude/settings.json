{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Read(**)",
      "Write(src/**)",
      "Write(docs/**)",
      "Write(.tmp/**)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run tsc:*)",
      "Bash(npm exec:*)",
      "Bash(npx:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm ls:*)",
      "Bash(node:*)",
      "Bash(uv add:*)",
      "Bash(uv run python:*)",
      "Bash(uv pip list:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(make:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(do)",
      "Bash(then)",
      "Bash(else)",
      "Bash(fi)",
      "Bash(done)",
      "Bash(for:*)",
      "Bash(true)",
      "Bash(vercel:*)",
      "Bash(gh:*)",
      "Bash(test:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:openai.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:docs.pytest.org)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:discuss.huggingface.co)",
      "WebFetch(domain:docs.vllm.ai)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:docling-project.github.io)",
      "WebFetch(domain:aioitertools.omnilib.dev)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:research.nvidia.com)",
      "WebFetch(domain:qwenlm.github.io)",
      "WebFetch(domain:www.microsoft.com)",
      "WebFetch(domain:swallow-llm.github.io)",
      "WebFetch(domain:mistral.ai)",
      "WebFetch(domain:qwen.readthedocs.io)",
      "WebFetch(domain:discuss.pytorch.org)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(curl -o:*)",
      "Bash(curl -O:*)",
      "Bash(curl --output:*)",
      "Bash(python:*)",
      "Bash(uv run pip install:*)",
      "Bash(uv add --index-strategy unsafe-best-match:*)",
      "Bash(python3:*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*key*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.venv/*)",
      "Write(**/pyproject.toml)",
      "Write(**/secrets/**)",
      "Write(./outputs/**)"
    ],
    "ask": [
      "Write(.claude/*)",
      "Write(CLAUDE.md)",
      "Write(**/CLAUDE.md)"
    ]
  }
}